# primary's zones now. The core grants the new image's authorizations before it
# runs the update hooks. A failure is logged only.

import os
import sys

sys.path.insert(0, os.path.join(os.environ['AGENT_INSTALL_DIR'], 'pypkg'))
import dnshelper_lib

dnshelper_lib.run_sync('update-module')
