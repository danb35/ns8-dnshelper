# Run by module-backup before Restic. The configuration already lives in plain
# files that are written atomically, so there is nothing to dump: just make sure
# every path in etc/state-include.conf exists (older Restic versions may treat a
# missing one as an error, which would fail the whole backup).

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'pypkg'))
import dnshelper_lib

dnshelper_lib.ensure_state()
