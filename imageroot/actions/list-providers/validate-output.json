{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "list-providers output",
    "$id": "http://nethserver.org/json-schema/task/output/dnshelper/list-providers",
    "description": "list-providers",
    "type": "object",
    "required": [
        "providers"
    ],
    "additionalProperties": false,
    "properties": {
        "providers": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "label",
                    "fields",
                    "types"
                ],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "label": {
                        "type": "string"
                    },
                    "notes": {
                        "type": "string"
                    },
                    "types": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "fields": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "name",
                                "label",
                                "secret",
                                "required"
                            ],
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "label": {
                                    "type": "string"
                                },
                                "secret": {
                                    "type": "boolean"
                                },
                                "required": {
                                    "type": "boolean"
                                },
                                "default": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
