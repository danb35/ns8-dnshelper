{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "has-zone output",
    "$id": "http://nethserver.org/json-schema/task/output/dnshelper/has-zone",
    "description": "has-zone",
    "type": "object",
    "required": [
        "managed",
        "zone",
        "allowed"
    ],
    "additionalProperties": false,
    "properties": {
        "managed": {
            "type": "boolean"
        },
        "zone": {
            "type": [
                "string",
                "null"
            ],
            "description": "The managed zone that contains the name"
        },
        "allowed": {
            "type": "boolean",
            "description": "Whether the caller may use the zone at all: always true for administrators, for a module whether its policy has a rule for it"
        }
    }
}
