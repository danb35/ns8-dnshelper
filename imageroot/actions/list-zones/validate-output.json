{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "list-zones output",
    "$id": "http://nethserver.org/json-schema/task/output/dnshelper/list-zones",
    "description": "list-zones",
    "type": "object",
    "required": [
        "zones"
    ],
    "additionalProperties": false,
    "properties": {
        "zones": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "zone",
                    "credential",
                    "provider",
                    "access",
                    "full"
                ],
                "properties": {
                    "zone": {
                        "type": "string"
                    },
                    "credential": {
                        "type": "string"
                    },
                    "provider": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "access": {
                        "enum": [
                            "write",
                            "read",
                            "none"
                        ],
                        "description": "What the caller may do in the zone: 'write' when some write rule covers it (whatever names and types it allows), 'read' when only read rules do, 'none' otherwise. Always 'write' for administrators"
                    },
                    "full": {
                        "type": "boolean",
                        "description": "Whether the caller may change every name and type in the zone (a write rule with names '*' and types '*'). Always true for administrators"
                    }
                }
            }
        }
    }
}
