{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "suggest-zones output",
    "$id": "http://nethserver.org/json-schema/task/output/dnshelper/suggest-zones",
    "type": "object",
    "required": [
        "candidates"
    ],
    "additionalProperties": false,
    "properties": {
        "candidates": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "zone",
                    "names",
                    "managed",
                    "managed_zone"
                ],
                "additionalProperties": false,
                "properties": {
                    "zone": {
                        "type": "string"
                    },
                    "names": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "managed": {
                        "type": "boolean"
                    },
                    "managed_zone": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "The already managed zone that contains this candidate"
                    }
                }
            }
        }
    }
}
