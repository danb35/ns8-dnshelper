set -e    # exit immediately if an error occurs
exec 1>&2 # ensure any output is sent to stderr

#
# Roles other modules acquire through the image label
#   org.nethserver.authorizations=dnshelper@cluster:dnswriter
# (dnshelper@node, dnshelper@any and comma-separated roles work too).
#
# Roles are module-wide: what a caller may actually touch is decided by the
# policy table, see imageroot/pypkg/dnshelper_lib.py.
#
reader_actions=(
    get-records
    list-zones
    has-zone
    list-owners
    check-propagation
    list-providers
)
writer_actions=(
    append-records
    set-records
    delete-records
    apply-changes
)
# Delegates (DESIGN.md, Delegated access, phase 2): also add credentials and
# zones of their own. The role alone is not enough: the module must also be
# listed in the "delegates" setting.
zoneadmin_actions=(
    list-provider-zones
    validate-zone
    add-credential
    update-credential
    remove-credential
    add-zone
    update-zone
    remove-zone
)
redis-exec SADD "${AGENT_ID}/roles/dnsreader" "${reader_actions[@]}"
redis-exec SADD "${AGENT_ID}/roles/dnswriter" "${reader_actions[@]}" "${writer_actions[@]}"
redis-exec SADD "${AGENT_ID}/roles/dnszoneadmin" "${reader_actions[@]}" "${writer_actions[@]}" "${zoneadmin_actions[@]}"
