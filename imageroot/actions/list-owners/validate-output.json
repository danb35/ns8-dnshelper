{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "list-owners output",
    "$id": "http://nethserver.org/json-schema/task/output/dnshelper/list-owners",
    "description": "list-owners",
    "type": "object",
    "required": [
        "zone",
        "owners"
    ],
    "additionalProperties": false,
    "properties": {
        "zone": {
            "type": "string"
        },
        "owners": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "type",
                    "data",
                    "callers",
                    "removed",
                    "time"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string"
                    },
                    "data": {
                        "type": "string"
                    },
                    "callers": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Modules (module/<id>) that wrote the record and are still installed"
                    },
                    "removed": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Modules that wrote it and were removed; with no callers left, the record is orphaned"
                    },
                    "time": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
