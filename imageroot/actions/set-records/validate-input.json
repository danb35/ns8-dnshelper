{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "set-records input",
    "$id": "http://nethserver.org/json-schema/task/input/dnshelper/set-records",
    "description": "set-records",
    "examples": [
        {
            "zone": "example.com",
            "records": [
                {
                    "name": "@",
                    "type": "TXT",
                    "data": "v=spf1 mx -all"
                }
            ],
            "replace_prefixes": [
                "v=spf1"
            ]
        }
    ],
    "type": "object",
    "required": [
        "zone",
        "records"
    ],
    "additionalProperties": false,
    "properties": {
        "zone": {
            "type": "string",
            "minLength": 3,
            "maxLength": 253,
            "description": "DNS zone, like 'example.com'"
        },
        "records": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "type",
                    "data"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Name relative to the zone, '@' for the apex"
                    },
                    "type": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9]+$",
                        "description": "Record type: A, AAAA, CNAME, TXT, SRV, MX, NS, CAA, HTTPS, SVCB"
                    },
                    "ttl": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Seconds; 0 lets the provider choose"
                    },
                    "data": {
                        "type": "string",
                        "description": "RDATA in unescaped zone-file syntax. TXT: the whole plain value, unquoted, any length"
                    }
                }
            }
        },
        "dry_run": {
            "type": "boolean",
            "description": "Report the changes without making them"
        },
        "mode": {
            "type": "string",
            "enum": [
                "merge",
                "rrset"
            ],
            "description": "merge (default) keeps other members of the RRset; rrset makes the input the only members"
        },
        "replace_prefixes": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "description": "merge mode: existing values starting with one of these are replaced, e.g. 'v=spf1'"
        }
    }
}
