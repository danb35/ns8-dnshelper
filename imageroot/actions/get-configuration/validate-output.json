{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get dnshelper settings",
    "$id": "http://nethserver.org/json-schema/task/output/dnshelper/get-configuration",
    "description": "Credentials (never their secrets) and zones",
    "type": "object",
    "required": [
        "credentials",
        "zones",
        "settings"
    ],
    "additionalProperties": false,
    "properties": {
        "credentials": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "provider",
                    "values",
                    "secrets_set"
                ],
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]{1,40}$",
                        "description": "Credential id"
                    },
                    "name": {
                        "type": "string"
                    },
                    "provider": {
                        "type": "string"
                    },
                    "values": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        },
                        "description": "Non-secret field values"
                    },
                    "secrets_set": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Names of secret fields that have a value"
                    },
                    "managed_by": {
                        "type": "string",
                        "description": "'module/<id>' when the credential was adopted from that ns8-powerdns primary and cannot be changed here; '' otherwise"
                    }
                }
            }
        },
        "zones": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "zone",
                    "credential"
                ],
                "additionalProperties": false,
                "properties": {
                    "zone": {
                        "type": "string"
                    },
                    "credential": {
                        "type": "string"
                    },
                    "managed_by": {
                        "type": "string",
                        "description": "'module/<id>' when the zone was adopted from that ns8-powerdns primary; '' otherwise"
                    },
                    "snapshots": {
                        "type": "integer",
                        "description": "Number of snapshots kept for the zone"
                    }
                }
            }
        },
        "settings": {
            "type": "object",
            "required": [
                "snapshot_max_count",
                "snapshot_max_age_days"
            ],
            "additionalProperties": false,
            "properties": {
                "snapshot_max_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                },
                "snapshot_max_age_days": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3650
                }
            }
        }
    }
}
