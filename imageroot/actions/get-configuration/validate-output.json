{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get dnshelper settings",
    "$id": "http://nethserver.org/json-schema/task/output/dnshelper/get-configuration",
    "description": "Credentials (never their secrets) and zones",
    "type": "object",
    "required": [
        "credentials",
        "zones"
    ],
    "additionalProperties": false,
    "properties": {
        "credentials": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "provider",
                    "values",
                    "secrets_set"
                ],
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]{1,40}$",
                        "description": "Credential id"
                    },
                    "name": {
                        "type": "string"
                    },
                    "provider": {
                        "type": "string"
                    },
                    "values": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        },
                        "description": "Non-secret field values"
                    },
                    "secrets_set": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Names of secret fields that have a value"
                    }
                }
            }
        },
        "zones": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "zone",
                    "credential"
                ],
                "additionalProperties": false,
                "properties": {
                    "zone": {
                        "type": "string"
                    },
                    "credential": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
