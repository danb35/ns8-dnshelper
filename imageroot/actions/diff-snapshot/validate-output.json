{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "diff-snapshot output",
    "$id": "http://nethserver.org/json-schema/task/output/dnshelper/diff-snapshot",
    "description": "diff-snapshot",
    "type": "object",
    "required": [
        "id",
        "remove",
        "add"
    ],
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^\\d{8}T\\d{6}\\.\\d{6}Z$",
            "description": "Snapshot id: its UTC time stamp"
        },
        "remove": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "record",
                    "changed_by"
                ],
                "additionalProperties": false,
                "properties": {
                    "record": {
                        "type": "object",
                        "required": [
                            "name",
                            "type",
                            "ttl",
                            "data"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Name relative to the zone, '@' for the apex"
                            },
                            "type": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9]+$",
                                "description": "Record type: A, AAAA, CNAME, TXT, SRV, MX, NS, CAA, HTTPS, SVCB"
                            },
                            "ttl": {
                                "type": "integer",
                                "minimum": 0,
                                "description": "Seconds; 0 lets the provider choose"
                            },
                            "data": {
                                "type": "string",
                                "description": "RDATA in unescaped zone-file syntax. TXT: the whole plain value, unquoted, any length"
                            }
                        }
                    },
                    "changed_by": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Callers that changed this record since the snapshot"
                    }
                }
            }
        },
        "add": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "record",
                    "changed_by"
                ],
                "additionalProperties": false,
                "properties": {
                    "record": {
                        "type": "object",
                        "required": [
                            "name",
                            "type",
                            "ttl",
                            "data"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Name relative to the zone, '@' for the apex"
                            },
                            "type": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9]+$",
                                "description": "Record type: A, AAAA, CNAME, TXT, SRV, MX, NS, CAA, HTTPS, SVCB"
                            },
                            "ttl": {
                                "type": "integer",
                                "minimum": 0,
                                "description": "Seconds; 0 lets the provider choose"
                            },
                            "data": {
                                "type": "string",
                                "description": "RDATA in unescaped zone-file syntax. TXT: the whole plain value, unquoted, any length"
                            }
                        }
                    },
                    "changed_by": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
