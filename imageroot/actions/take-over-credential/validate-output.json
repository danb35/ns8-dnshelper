{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "take-over-credential output",
    "$id": "http://nethserver.org/json-schema/task/output/dnshelper/take-over-credential",
    "description": "take-over-credential",
    "type": "object",
    "required": [
        "id",
        "delegated_to",
        "zones"
    ],
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string"
        },
        "delegated_to": {
            "type": "string",
            "description": "The module the credential was delegated to, 'module/<id>'"
        },
        "zones": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "The zones that use the credential, now hand-configured too"
        }
    }
}
