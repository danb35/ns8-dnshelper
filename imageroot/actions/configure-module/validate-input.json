{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configure dnshelper",
    "$id": "http://nethserver.org/json-schema/task/input/dnshelper/configure-module",
    "description": "Module-wide settings: snapshot retention. Keys left out keep their value; the UI may also send no payload at all.",
    "examples": [
        {
            "snapshot_max_count": 50,
            "snapshot_max_age_days": 90
        }
    ],
    "type": [
        "object",
        "null"
    ],
    "additionalProperties": false,
    "properties": {
        "snapshot_max_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
        },
        "snapshot_max_age_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3650
        }
    }
}
