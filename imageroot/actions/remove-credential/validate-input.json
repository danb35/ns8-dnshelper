{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "remove-credential input",
    "$id": "http://nethserver.org/json-schema/task/input/dnshelper/remove-credential",
    "description": "remove-credential",
    "examples": [
        {
            "id": "c1a2b3c4"
        }
    ],
    "type": "object",
    "required": [
        "id"
    ],
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,40}$",
            "description": "Credential id"
        }
    }
}
