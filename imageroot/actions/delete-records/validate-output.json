{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "delete-records output",
    "$id": "http://nethserver.org/json-schema/task/output/dnshelper/delete-records",
    "description": "delete-records",
    "type": "object",
    "required": [
        "dry_run",
        "changes",
        "records"
    ],
    "additionalProperties": false,
    "properties": {
        "dry_run": {
            "type": "boolean"
        },
        "changes": {
            "type": "object",
            "required": [
                "add",
                "remove"
            ],
            "additionalProperties": false,
            "properties": {
                "add": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "type",
                            "ttl",
                            "data"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Name relative to the zone, '@' for the apex"
                            },
                            "type": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9]+$",
                                "description": "Record type: A, AAAA, CNAME, TXT, SRV, MX, NS, CAA, HTTPS, SVCB"
                            },
                            "ttl": {
                                "type": "integer",
                                "minimum": 0,
                                "description": "Seconds; 0 lets the provider choose"
                            },
                            "data": {
                                "type": "string",
                                "description": "RDATA in unescaped zone-file syntax. TXT: the whole plain value, unquoted, any length"
                            }
                        }
                    }
                },
                "remove": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "type",
                            "ttl",
                            "data"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Name relative to the zone, '@' for the apex"
                            },
                            "type": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9]+$",
                                "description": "Record type: A, AAAA, CNAME, TXT, SRV, MX, NS, CAA, HTTPS, SVCB"
                            },
                            "ttl": {
                                "type": "integer",
                                "minimum": 0,
                                "description": "Seconds; 0 lets the provider choose"
                            },
                            "data": {
                                "type": "string",
                                "description": "RDATA in unescaped zone-file syntax. TXT: the whole plain value, unquoted, any length"
                            }
                        }
                    }
                }
            }
        },
        "records": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "type",
                    "ttl",
                    "data"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Name relative to the zone, '@' for the apex"
                    },
                    "type": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9]+$",
                        "description": "Record type: A, AAAA, CNAME, TXT, SRV, MX, NS, CAA, HTTPS, SVCB"
                    },
                    "ttl": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Seconds; 0 lets the provider choose"
                    },
                    "data": {
                        "type": "string",
                        "description": "RDATA in unescaped zone-file syntax. TXT: the whole plain value, unquoted, any length"
                    }
                }
            },
            "description": "Records as reported by the provider after the change"
        }
    }
}
