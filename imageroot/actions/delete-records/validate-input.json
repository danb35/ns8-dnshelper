{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "delete-records input",
    "$id": "http://nethserver.org/json-schema/task/input/dnshelper/delete-records",
    "description": "delete-records",
    "examples": [
        {
            "zone": "example.com",
            "records": [
                {
                    "name": "_acme-challenge",
                    "type": "TXT",
                    "data": "token"
                }
            ]
        }
    ],
    "type": "object",
    "required": [
        "zone",
        "records"
    ],
    "additionalProperties": false,
    "properties": {
        "zone": {
            "type": "string",
            "minLength": 3,
            "maxLength": 253,
            "description": "DNS zone, like 'example.com'"
        },
        "records": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
                "type": "object",
                "required": [
                    "name"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Name relative to the zone, '@' for the apex"
                    },
                    "type": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9]+$",
                        "description": "Record type: A, AAAA, CNAME, TXT, SRV, MX, NS, CAA, HTTPS, SVCB"
                    },
                    "ttl": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Seconds; 0 lets the provider choose"
                    },
                    "data": {
                        "type": "string",
                        "description": "RDATA in unescaped zone-file syntax. TXT: the whole plain value, unquoted, any length"
                    }
                }
            }
        },
        "dry_run": {
            "type": "boolean",
            "description": "Report the changes without making them"
        }
    }
}
