{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "update-credential input",
    "$id": "http://nethserver.org/json-schema/task/input/dnshelper/update-credential",
    "description": "update-credential",
    "examples": [
        {
            "id": "c1a2b3c4",
            "fields": {
                "api_token": "new"
            }
        }
    ],
    "type": "object",
    "required": [
        "id"
    ],
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,40}$",
            "description": "Credential id"
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
        },
        "fields": {
            "type": "object",
            "additionalProperties": {
                "type": "string",
                "maxLength": 4096
            },
            "description": "Fields to change. An empty secret field keeps the stored value."
        }
    }
}
