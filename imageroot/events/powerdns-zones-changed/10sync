# An ns8-powerdns primary published powerdns-zones-changed or
# powerdns-provider-changed: reconcile the adopted zones and credential with it.
# The payload is not trusted: the sync looks at the cluster as it is. A failure
# is logged only; the next event or the Sync button tries again.

import os
import sys

sys.path.insert(0, os.path.join(os.environ['AGENT_INSTALL_DIR'], 'pypkg'))
import dnshelper_lib

dnshelper_lib.run_sync(os.environ.get('AGENT_EVENT_NAME', 'event') + ' from ' + os.environ.get('AGENT_EVENT_SOURCE', '?'))
