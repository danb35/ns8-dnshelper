# The core publishes cluster/event/module-removed {"module", "node"} after it
# has deleted the module's keys. Drop the removed module from the writers of
# the records it wrote through dnshelper; records it leaves with no writer
# are flagged on the Records page for the administrator to delete or keep.
# Nothing is deleted here (DESIGN.md, Records editor: record owners).

import json
import os
import sys

sys.path.insert(0, os.path.join(os.environ['AGENT_INSTALL_DIR'], 'pypkg'))
import agent
import dnshelper_lib

try:
    removed = json.load(sys.stdin).get('module')
except (ValueError, AttributeError):
    removed = None

if removed and removed != os.environ.get('MODULE_ID'):
    try:
        orphaned = dnshelper_lib.forget_module(removed)
    except OSError as e:
        print(agent.SD_WARNING + 'dnshelper: cannot update record owners after %s was removed: %s'
              % (removed, type(e).__name__), file=sys.stderr)
        sys.exit(0)
    for zone, n in sorted(orphaned.items()):
        print(agent.SD_INFO + 'dnshelper: %s was removed; %d record(s) of %s it wrote are left for the '
              'administrator to delete or keep' % (removed, n, zone), file=sys.stderr)
