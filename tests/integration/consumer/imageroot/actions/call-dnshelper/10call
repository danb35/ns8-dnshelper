# A stand-in for a real consumer module (mail, an ACME client...): find dnshelper
# the way the README tells consumers to, call one of its actions, and report what
# came back, so that a test can see exactly what a consumer would see.

import json
import sys

import agent

data = json.load(sys.stdin)

rdb = agent.redis_connect(use_replica=True)
providers = agent.list_service_providers(rdb, 'dnshelper')
if not providers:
    json.dump({'present': False}, fp=sys.stdout)
    sys.exit(0)

target = 'module/' + providers[0]['module_id']
try:
    r = agent.tasks.run(agent_id=target, action=data['action'], data=data.get('data', {}))
except Exception as ex:
    # e.g. 403 from the api-server when the action is outside the granted role
    json.dump({'present': True, 'provider': target, 'refused': str(ex)[:300]}, fp=sys.stdout)
    sys.exit(0)
json.dump({
    'present': True,
    'provider': target,
    'exit_code': r['exit_code'],
    'output': r.get('output'),
    'error': r.get('error'),
}, fp=sys.stdout)
